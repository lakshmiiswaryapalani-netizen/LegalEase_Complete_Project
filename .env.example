# Required for real Gemini generation.
GEMINI_API_KEY=your_gemini_api_key_here

# Current stable model used by the project. Change only if your account has access.
GEMINI_MODEL=gemini-3.8-flash

# Set false only when you want the application to fail clearly if the Gemini key is missing.
# With true, LegalEase starts in a deterministic demo mode when no key is available.
DEMO_MODE=true

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_API_URL=http://127.0.0.1:8000

COMPANY_NAME=LegalEase
COMPANY_TAGLINE=AI-Powered Legal Document Generator
